.DS_Store
BibiApp/.generated/
**/__pycache__/
**/xcuserdata/
**/DerivedData/
**/.build/
!BibiApp/Bibi.xcodeproj/xcshareddata/
!BibiApp/Bibi.xcodeproj/xcshareddata/xcschemes/
!BibiApp/Bibi.xcodeproj/xcshareddata/xcschemes/Bibi.xcscheme
/Assets/*

# Keep the canonical agreements and their PDF publication record in source control.
!/Assets/TermsOfService.pdf
!/Assets/PrivacyPolicy.pdf
!/Assets/TermsOfService.html
!/Assets/PrivacyPolicy.html
!/Assets/agreement-source-TermsOfService.txt
!/Assets/agreement-source-PrivacyPolicy.txt
!/Assets/agreement-source-provenance.json

# Keep dependency resolution reproducible without adding generated workspace state.
!BibiApp/Bibi.xcodeproj/project.xcworkspace/
BibiApp/Bibi.xcodeproj/project.xcworkspace/*
!BibiApp/Bibi.xcodeproj/project.xcworkspace/xcshareddata/
BibiApp/Bibi.xcodeproj/project.xcworkspace/xcshareddata/*
!BibiApp/Bibi.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
BibiApp/Bibi.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!BibiApp/Bibi.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Generated test evidence stays on the local machine.
/BibiApp/Design/RunEvidence/
**/*.xcresult/
**/*.xcactivitylog

