      "revision_id": "9e4be01d-bfb9-5bb6-8083-bcde0f724ee8",
      "editorial": true,
      "parent_id": "cb120000-0000-4000-8000-000000000005",
      "source_kind": "fictional_story_reply"
    },
    {
      "id": "cb130000-0000-4000-8000-000000000051",
      "kind": "reply",
      "editorial_profile_id": "bibi-story:nova",
      "title": "",
      "body": "I would keep one pom-pom and drop the rest.",
      "created_at": "2026-10-25T20:10:00Z",
